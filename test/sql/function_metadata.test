# name: test/sql/function_metadata.test
# description: every bitfilters overload is documented in duckdb_functions()
# group: [sql]

require bitfilters

# Every overload, including the BLOB (merge) overload of quotient_filter, has a
# description, examples, categories and real parameter names (descriptions
# only attach to overloads whose parameter_types match, and names come from
# the signature, which defaults to col0, col1, ...). Functions are matched by
# name since extension_name is NULL when the extension is linked statically.
query I
SELECT count(*) FROM duckdb_functions() WHERE regexp_matches(function_name, '^(((binary_fuse|xor)(8|16)|quotient|bloom)_filter(_contains|_info|_is_valid|_merge)?|bitfilter_(contains|info|is_valid))$|^bitfilters_')
----
33

query IIII
SELECT function_name, function_type, parameters, parameter_types
FROM duckdb_functions()
WHERE regexp_matches(function_name, '^(((binary_fuse|xor)(8|16)|quotient|bloom)_filter(_contains|_info|_is_valid|_merge)?|bitfilter_(contains|info|is_valid))$|^bitfilters_')
  AND (description IS NULL OR description = ''
       OR examples IS NULL OR len(examples) = 0
       OR categories IS NULL OR len(categories) = 0
       OR len(parameters) <> len(parameter_types)
       OR len(list_distinct(parameters)) <> len(parameters)
       OR len(list_filter(parameters, lambda p: regexp_matches(p, '^(col[0-9]+|args|kwargs)$')
                                          OR regexp_matches(p, '_[0-9]+$'))) > 0)
ORDER BY ALL
----

query III
SELECT parameters, parameter_types, categories
FROM duckdb_functions()
WHERE function_name = 'quotient_filter'
ORDER BY parameter_types::VARCHAR
----
[r, value]	[INTEGER, ANY]	[bitfilters, probabilistic]
[q, r, value]	[INTEGER, INTEGER, ANY]	[bitfilters, probabilistic]
[q, r, filter]	[INTEGER, INTEGER, BLOB]	[bitfilters, probabilistic]
