# name: test/sql/duckdb_hash_v2.test
# description: bitfilters_duckdb_hash('v2.0', ...) must match DuckDB 2.0's own hash() in the same build.
#              DuckDB 2.0 kept the v1.4-v1.6 hash algorithms (MurmurHash64 / HashBytes / CombineHashScalar),
#              so 'v2.0' maps to the same implementation; these tests prove it against the running engine.
# group: [bitfilters]

require bitfilters

# Version spellings
query T
SELECT bitfilters_duckdb_hash('v2.0', 42) = bitfilters_duckdb_hash('2.0', 42)
   AND bitfilters_duckdb_hash('v2.0', 42) = bitfilters_duckdb_hash('v2.0.0', 42)
   AND bitfilters_duckdb_hash('v2.0', 42) = bitfilters_duckdb_hash('2.0.0', 42);
----
true

# Same values as the certified v1.x results
query I
SELECT bitfilters_duckdb_hash('v2.0', 42::INTEGER)::UBIGINT;
----
7199933130570745587

query I
SELECT bitfilters_duckdb_hash('v2.0', 'hello'::VARCHAR)::UBIGINT;
----
8628213525773890682

query I
SELECT bitfilters_duckdb_hash('v2.0', 42, 'hello')::UBIGINT;
----
17001236256828606196

# ============================================================================
# Constant arguments, compared with hash() for every supported physical type
# ============================================================================

query T
SELECT bool_and(bitfilters_duckdb_hash('v2.0', v) = hash(v)) FROM (VALUES
    (0::TINYINT), (1::TINYINT), ((-1)::TINYINT), ((-128)::TINYINT), (127::TINYINT)) t(v);
----
true

query T
SELECT bool_and(bitfilters_duckdb_hash('v2.0', v) = hash(v)) FROM (VALUES
    (0::SMALLINT), ((-1)::SMALLINT), ((-32768)::SMALLINT), (32767::SMALLINT)) t(v);
----
true

query T
SELECT bool_and(bitfilters_duckdb_hash('v2.0', v) = hash(v)) FROM (VALUES
    (0::INTEGER), ((-1)::INTEGER), ((-2147483648)::INTEGER), (2147483647::INTEGER), (42::INTEGER)) t(v);
----
true

query T
SELECT bool_and(bitfilters_duckdb_hash('v2.0', v) = hash(v)) FROM (VALUES
    (0::BIGINT), ((-1)::BIGINT), ((-9223372036854775808)::BIGINT), (9223372036854775807::BIGINT)) t(v);
----
true

query T
SELECT bool_and(bitfilters_duckdb_hash('v2.0', v) = hash(v)) FROM (VALUES (0::UTINYINT), (255::UTINYINT)) t(v);
----
true

query T
SELECT bool_and(bitfilters_duckdb_hash('v2.0', v) = hash(v)) FROM (VALUES (0::USMALLINT), (65535::USMALLINT)) t(v);
----
true

query T
SELECT bool_and(bitfilters_duckdb_hash('v2.0', v) = hash(v)) FROM (VALUES (0::UINTEGER), (4294967295::UINTEGER)) t(v);
----
true

query T
SELECT bool_and(bitfilters_duckdb_hash('v2.0', v) = hash(v)) FROM (VALUES
    (0::UBIGINT), (18446744073709551615::UBIGINT)) t(v);
----
true

query T
SELECT bool_and(bitfilters_duckdb_hash('v2.0', v) = hash(v)) FROM (VALUES (true), (false)) t(v);
----
true

# FLOAT / DOUBLE including -0.0 (normalized to +0.0), NaN, -NaN and infinities
query T
SELECT bool_and(bitfilters_duckdb_hash('v2.0', v) = hash(v)) FROM (VALUES
    (0.0::FLOAT), ((-0.0)::FLOAT), (42::FLOAT), ((-3.5)::FLOAT), ('nan'::FLOAT), (-('nan'::FLOAT)),
    ('inf'::FLOAT), ('-inf'::FLOAT)) t(v);
----
true

query T
SELECT bool_and(bitfilters_duckdb_hash('v2.0', v) = hash(v)) FROM (VALUES
    (0.0::DOUBLE), ((-0.0)::DOUBLE), (42::DOUBLE), (3.14::DOUBLE), ('nan'::DOUBLE), (-('nan'::DOUBLE)),
    ('inf'::DOUBLE), ('-inf'::DOUBLE), (1e308::DOUBLE)) t(v);
----
true

query T
SELECT bitfilters_duckdb_hash('v2.0', (-0.0)::DOUBLE) = bitfilters_duckdb_hash('v2.0', 0.0::DOUBLE)
   AND bitfilters_duckdb_hash('v2.0', -('nan'::DOUBLE)) = bitfilters_duckdb_hash('v2.0', 'nan'::DOUBLE);
----
true

# VARCHAR: empty, inlined (<= 12 bytes), exactly 8/12/13 bytes, long non-inlined, multi-byte UTF-8
query T
SELECT bool_and(bitfilters_duckdb_hash('v2.0', v) = hash(v)) FROM (VALUES
    (''), ('a'), ('hello'), ('12345678'), ('123456789012'), ('1234567890123'),
    ('a longer string for testing'), ('héllo wörld ✓ 日本語'), (repeat('xyz', 1000))) t(v);
----
true

# BLOB
query T
SELECT bool_and(bitfilters_duckdb_hash('v2.0', v) = hash(v)) FROM (VALUES
    (''::BLOB), ('\xDEAD'::BLOB), ('\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0A\x0B\x0C\x0D\x0E'::BLOB)) t(v);
----
true

# Logical types backed by supported physical types
query T
SELECT bitfilters_duckdb_hash('v2.0', DATE '2024-02-29') = hash(DATE '2024-02-29')
   AND bitfilters_duckdb_hash('v2.0', TIMESTAMP '2024-02-29 12:34:56.789') = hash(TIMESTAMP '2024-02-29 12:34:56.789')
   AND bitfilters_duckdb_hash('v2.0', TIME '12:34:56') = hash(TIME '12:34:56');
----
true

# ============================================================================
# Vectorized (non-constant) inputs from tables, compared row by row with hash()
# ============================================================================

statement ok
CREATE TABLE hv AS SELECT
    i::TINYINT AS i8, (i * 37)::SMALLINT AS i16, (i * 104729 - 5000000)::INTEGER AS i32,
    (i * 2654435761 - 9000000000)::BIGINT AS i64,
    ((i + 100) % 256)::UTINYINT AS u8, ((i + 100) * 251)::USMALLINT AS u16, ((i + 100) * 21000000)::UINTEGER AS u32,
    ((i + 100)::UBIGINT * 91000000000000000)::UBIGINT AS u64,
    (i / 7.0 - 9)::FLOAT AS f32, (i / 3.0 - 50)::DOUBLE AS f64,
    (i % 2 = 0) AS b,
    repeat(chr((65 + (i + 100) % 26)::INTEGER), ((i + 100) % 40)::INTEGER) AS s,
    ('k' || i)::BLOB AS bl
FROM range(-100, 101) t(i);

query I
SELECT COUNT(*) FROM hv WHERE
    bitfilters_duckdb_hash('v2.0', i8) <> hash(i8) OR bitfilters_duckdb_hash('v2.0', i16) <> hash(i16) OR
    bitfilters_duckdb_hash('v2.0', i32) <> hash(i32) OR bitfilters_duckdb_hash('v2.0', i64) <> hash(i64) OR
    bitfilters_duckdb_hash('v2.0', u8) <> hash(u8) OR bitfilters_duckdb_hash('v2.0', u16) <> hash(u16) OR
    bitfilters_duckdb_hash('v2.0', u32) <> hash(u32) OR bitfilters_duckdb_hash('v2.0', u64) <> hash(u64) OR
    bitfilters_duckdb_hash('v2.0', f32) <> hash(f32) OR bitfilters_duckdb_hash('v2.0', f64) <> hash(f64) OR
    bitfilters_duckdb_hash('v2.0', b) <> hash(b) OR bitfilters_duckdb_hash('v2.0', s) <> hash(s) OR
    bitfilters_duckdb_hash('v2.0', bl) <> hash(bl);
----
0

# Multi-column combine (CombineHashScalar) across mixed types
query I
SELECT COUNT(*) FROM hv WHERE
    bitfilters_duckdb_hash('v2.0', i32, s) <> hash(i32, s) OR
    bitfilters_duckdb_hash('v2.0', s, f64, i8, bl) <> hash(s, f64, i8, bl) OR
    bitfilters_duckdb_hash('v2.0', u64, b, f32, i16, u16) <> hash(u64, b, f32, i16, u16);
----
0

# Dictionary / repeated values
query I
SELECT COUNT(*) FROM (SELECT ['red', 'green', 'blue a long enough string'][1 + (i % 3)::INT] AS c FROM range(5000) t(i))
WHERE bitfilters_duckdb_hash('v2.0', c) <> hash(c);
----
0

# ============================================================================
# NULL: bitfilters_duckdb_hash propagates NULL (DuckDB's hash() returns a fixed NULL hash instead)
# ============================================================================

query T
SELECT bitfilters_duckdb_hash('v2.0', NULL::INTEGER) IS NULL;
----
true

query T
SELECT bitfilters_duckdb_hash('v2.0', 1, NULL::VARCHAR) IS NULL;
----
true

# ============================================================================
# Bloom filter round trip with v2.0
# ============================================================================

statement ok
CREATE TABLE bf2_filter AS
SELECT bitfilters_duckdb_bloom_filter_create('v2.0', 16384, bitfilters_duckdb_hash('v2.0', i32, s)) AS filter FROM hv;

query I
SELECT COUNT(*) FROM hv WHERE bitfilters_duckdb_bloom_filter_probe('v2.0', (SELECT filter FROM bf2_filter), i32, s);
----
201

# A filter built from DuckDB's own hash() values probes identically
statement ok
CREATE TABLE bf2_native AS
SELECT bitfilters_duckdb_bloom_filter_create('v2.0', 16384, hash(i32, s)) AS filter FROM hv;

query T
SELECT (SELECT filter FROM bf2_native) = (SELECT filter FROM bf2_filter);
----
true
